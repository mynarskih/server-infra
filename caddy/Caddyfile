        root * /srv-portfolio
        file_server
    }
}

whiteboard.serwerbb.win {
 tls {
  ca https://acme-v02.api.letsencrypt.org/directory
 }
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Frame-Options DENY
  Permissions-Policy "camera=(), microphone=(), geolocation=()"
  -Server
 }
 request_body {
  max_size 8MB
 }
 @ws path /ws
 @unusedActions header Next-Action *
 handle @unusedActions {
  respond "Unsupported request" 400
 }
 handle @ws {
  reverse_proxy velin-sync:3001 {
   header_up X-Real-IP {remote_host}
   header_up Host whiteboard.serwerbb.win
   header_up X-Forwarded-Host whiteboard.serwerbb.win
   header_up X-Forwarded-Proto https
   stream_close_delay 5m
  }
 }
 handle {
  reverse_proxy velin-web:3000 {
   header_up X-Real-IP {remote_host}
   header_up Host whiteboard.serwerbb.win
   header_up X-Forwarded-Host whiteboard.serwerbb.win
   header_up X-Forwarded-Proto https
  }
 }
 handle_errors {
  header Cache-Control no-store
  respond "<!doctype html><html lang=\"pl\"><meta charset=\"utf-8\"><title>Velin — niedostępne</title><body><h1>Chwilowa przerwa</h1><p>Serwer tablic jest chwilowo niedostępny. Spróbuj ponownie za moment.</p></body></html>" {err.status_code}
 }
}

